{
  "name": "piano-hieu-ung",
  "version": "1.0.0",
  "description": "Piano Hiệu Ứng: Vietnamese-first MIDI visualization, audio-to-MIDI and MP4 export.",
  "license": "MIT",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "npm run test:tracks && npm run test:video && npm run test:velocity && npm run test:export && npm run test:editor && npm run test:playhead && npm run test:selection && npm run test:quantize && npm run test:velocity-editor && npm run test:scale && npm run test:chords && npm run test:instruments && npm run test:local-wav && npm run test:kontakt && npm run test:web-midi && npm run test:kontakt-routing && npm run test:kontakt-audio && npm run test:midi-overlap && npm run test:nki-workflow && npm run test:global-instruments && npm run test:simple-instruments && npm run test:erhu-cache && npm run test:gm-audio && npm run test:track-volume && npm run test:desktop && npm run test:expression && npm run test:midi-program-export && npm run test:offline-mix && npm run test:track-edit && npm run test:note-draw && npm run test:original-audio && npm run test:kontakt-desktop && npm run test:vst3-foundation && npm run test:vst3-stage3 && run-p type-check \"build-only {@}\" --",
    "preview": "vite preview",
    "test:tracks": "node --experimental-strip-types tests/midi-tracks.mjs",
    "test:video": "node --experimental-strip-types tests/video-format.mjs",
    "test:velocity": "node --experimental-strip-types tests/velocity-effects.mjs",
    "test:export": "node --experimental-strip-types tests/export-timing.mjs",
    "test:editor": "node --experimental-strip-types tests/midi-edit.mjs",
    "test:playhead": "node --experimental-strip-types tests/piano-roll-playhead.mjs",
    "test:selection": "node --experimental-strip-types tests/piano-roll-selection.mjs",
    "test:quantize": "node --experimental-strip-types tests/piano-roll-quantize.mjs",
    "test:velocity-editor": "node --experimental-strip-types tests/piano-roll-velocity.mjs",
    "test:scale": "node --experimental-strip-types tests/piano-roll-scale.mjs",
    "test:chords": "node --experimental-strip-types tests/piano-roll-chords.mjs",
    "test:instruments": "node --experimental-strip-types tests/melorix-instruments.mjs",
    "test:local-wav": "node --experimental-strip-types tests/melorix-local-wav.mjs",
    "test:kontakt": "node --experimental-strip-types tests/melorix-kontakt-import.mjs",
    "test:web-midi": "node --experimental-strip-types tests/melorix-web-midi.mjs",
    "build-only": "vite build",
    "type-check": "vue-tsc --build --force",
    "test:kontakt-routing": "node --experimental-strip-types tests/melorix-kontakt-routing.mjs",
    "test:kontakt-audio": "node --experimental-strip-types tests/melorix-kontakt-audio.mjs",
    "test:midi-overlap": "node --experimental-strip-types tests/melorix-midi-overlap.mjs",
    "test:nki-workflow": "node tests/melorix-nki-real-workflow.mjs",
    "test:global-instruments": "node --experimental-strip-types tests/melorix-global-instruments.mjs",
    "test:simple-instruments": "node tests/melorix-simple-instrument-flow.mjs",
    "test:erhu-cache": "node --experimental-strip-types tests/melorix-erhu-sample-cache.mjs",
    "test:gm-audio": "node --experimental-strip-types tests/melorix-gm-audio.mjs",
    "test:track-volume": "node --experimental-strip-types tests/melorix-track-volume.mjs",
    "test:desktop": "node tests/melorix-desktop.mjs",
    "desktop:build:win": "electron-builder --win portable nsis --x64 --publish never",
    "test:expression": "node --experimental-strip-types tests/melorix-expressive-audio.mjs",
    "test:midi-program-export": "node --experimental-strip-types tests/melorix-midi-program-export.mjs",
    "test:offline-mix": "node --experimental-strip-types tests/melorix-offline-mix.mjs",
    "test:track-edit": "node --experimental-strip-types tests/melorix-track-select-delete.mjs",
    "test:note-draw": "node --experimental-strip-types tests/melorix-note-draw.mjs",
    "test:original-audio": "node tests/melorix-original-audio.mjs",
    "test:kontakt-desktop": "node --experimental-strip-types tests/melorix-desktop-kontakt-live.mjs",
    "test:vst3-foundation": "node tests/melorix-vst3-foundation.mjs",
    "test:vst3-stage3": "node tests/melorix-vst3-stage3.mjs"
  },
  "dependencies": {
    "@fortawesome/fontawesome-free": "^7.0.0",
    "@spotify/basic-pitch": "^1.0.1",
    "@tensorflow/tfjs-backend-webgl": "^4.22.0",
    "@tensorflow/tfjs-converter": "^4.22.0",
    "@tensorflow/tfjs-core": "^4.22.0",
    "@tonejs/midi": "^2.0.28",
    "mediabunny": "^1.46.0",
    "smplr": "^0.26.0",
    "vue": "^3.4.0",
    "vue-i18n": "^11.4.4"
  },
  "devDependencies": {
    "@tsconfig/node18": "^18.2.2",
    "@types/node": "^18.19.3",
    "@vitejs/plugin-vue": "^4.5.2",
    "@vue/tsconfig": "^0.5.0",
    "autoprefixer": "^10.5.0",
    "npm-run-all2": "^6.1.1",
    "postcss": "^8.5.10",
    "tailwindcss": "^3.4.19",
    "typescript": "~5.3.0",
    "vite": "^5.0.10",
    "vue-tsc": "^1.8.25"
  },
  "main": "desktop/main.cjs"
}
